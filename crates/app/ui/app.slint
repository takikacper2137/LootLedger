import { ScrollView, ListView, Palette } from "std-widgets.slint";
import { Tokens, Tip, Drag } from "tokens.slint";
import { Icons } from "icons.slint";
import { CardData, DashRow, Cell, TableRow, BarRow, ChartPoint, Slice, HeatCell, Check, RingData, Trophy, Mark } from "types.slint";
import { Icon, IconButton, Button, TextField, Select, Card } from "controls.slint";
import { Anim } from "charts.slint";
import { Dash, DashGrid } from "dashboard.slint";
import { Settings, SettingsPage } from "settings.slint";
export { Overlay, MatchPopup } from "overlay.slint";
export { Summary } from "summary.slint";
import { Pages, Row, MatchesPage, OpeningsPage, TeammatesPage, TeamSessionsPage, TeamSession, CorrectDialog } from "pages.slint";
export { Tokens, Icons, Anim, Dash, Settings, Tip, Drag, Palette, Pages, TeamSession, Row }
export { CardData, DashRow, Cell, TableRow, BarRow, ChartPoint, Slice, HeatCell, Check, RingData, Trophy, Mark }

// Window controls: Fluent glyphs, 46x32, red close hover, dimmed while the window is inactive.
component CaptionButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> close;
    in property <bool> hover-override;
    in property <bool> active: true;
    callback clicked;
    width: 46px;
    height: 32px;
    property <bool> hot: area.has-hover || hover-override;
    background: close && hot ? Tokens.close-hover : hot ? (area.pressed ? Tokens.on-surface.with-alpha(0.12) : Tokens.on-surface.with-alpha(0.08)) : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    Text {
        text: glyph;
        font-family: "Segoe Fluent Icons";
        font-size: 10px;
        color: close && hot ? Tokens.on-close : active ? Tokens.on-surface : Tokens.on-surface.with-alpha(0.45);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea { clicked => { clicked(); } }
}

component RailItem inherits VerticalLayout {
    in property <string> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    spacing: Tokens.xs;
    alignment: start;
    accessible-role: tab;
    accessible-label: text;
    accessible-checked: selected;
    accessible-action-default => { clicked(); }
    forward-focus: focus;
    Rectangle {
        height: 32px;
        indicator := Rectangle {
            width: selected ? 56px : (area.has-hover ? 56px : 0px);
            x: (parent.width - self.width) / 2;
            height: 32px;
            border-radius: Tokens.pill(32px);
            background: selected ? Tokens.secondary-container : Tokens.on-surface.with-alpha(0.08);
            animate width { duration: Tokens.medium; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
        }
        Icon { name: icon; color: selected ? Tokens.on-secondary-container : Tokens.on-surface-variant; }
        focus := FocusScope {
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" { clicked(); return accept; }
                reject
            }
        }
        area := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
        Rectangle {
            width: 60px;
            x: (parent.width - self.width) / 2;
            border-width: focus.has-focus ? 2px : 0px;
            border-color: Tokens.primary;
            border-radius: Tokens.pill(32px);
        }
    }
    Text {
        text: root.text;
        font-size: Tokens.label;
        font-weight: selected ? 700 : 500;
        color: selected ? Tokens.on-surface : Tokens.on-surface-variant;
        horizontal-alignment: center;
    }
}

// Pages fade in and slide 24 px along the direction of travel (Reduced motion: fade only).
component PageHost inherits Rectangle {
    in property <bool> forward;
    property <bool> shown: false;
    init => { shown = true; }
    opacity: shown ? 1 : 0;
    x: shown || !Tokens.full-motion ? 0px : (forward ? 24px : -24px);
    animate opacity, x { duration: Tokens.medium; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
    @children
}

component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: Tokens.s;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Tokens.xxs;
        alignment: center;
        Text { text: title; font-size: Tokens.headline; font-weight: 600; color: Tokens.on-surface; }
        if subtitle != "": Text { text: subtitle; font-size: Tokens.body; color: Tokens.on-surface-variant; wrap: word-wrap; }
    }
    @children
}

export component AppWindow inherits Window {
    title: "LootLedger";
    no-frame: true;
    preferred-width: 1240px;
    preferred-height: 860px;
    min-width: 860px;
    min-height: 580px;
    background: Tokens.surface;
    default-font-family: "Segoe UI";
    default-font-size: Tokens.body;
    in-out property <int> page: 0;
    in-out property <int> previous-page: 0;
    in property <bool> show-page-title;
    in property <bool> is-maximized;
    in property <bool> max-hover;
    in property <bool> window-active: true;
    in property <string> live-chip;
    in property <int> live-chip-tone; // 0 none, 1 live, 2 saving, 3 counted
    // Overview
    in property <[DashRow]> overview-rows;
    in property <[DashRow]> stats-rows;
    in property <string> overview-subtitle;
    in property <string> stats-subtitle;
    in property <string> status;
    in property <int> status-tone;
    in property <[string]> missing-widgets;
    in-out property <bool> editing;
    in property <string> snack;
    in property <int> snack-id;
    property <[{title: string, icon: string, sub: string}]> pages: [
        { title: "Overview", icon: Icons.dashboard, sub: "" },
        { title: "Matches", icon: Icons.sports-esports, sub: "Matches read from your replays. Select one to see its breakdown and timeline." },
        { title: "Openings", icon: Icons.inventory-2, sub: "Every chest you opened, newest first. Corrections are recorded and never silently lost." },
        { title: "Statistics", icon: Icons.insights, sub: "" },
        { title: "Teammates", icon: Icons.groups, sub: "Everyone who played with you, merged across matches. Pick someone to see their profile." },
        { title: "Team Sessions", icon: Icons.groups, sub: "Play together: share parsed replay data with your squad." },
        { title: "Settings", icon: Icons.settings, sub: "Changes apply immediately. Your replays and ledger never leave this PC." },
    ];
    callback minimize;
    callback maximize;
    callback request-close;
    callback navigate(int);
    callback columns-changed(int);
    callback stats-columns-changed(int);
    callback overview-action(string);
    callback add-widget(int);
    callback reset-layout;
    changed page => { root.navigate(root.page); }

    // Dialogs: 0 none, 1 command palette, 2 information (shortcuts, welcome, what's new)
    in-out property <int> dialog;
    in property <string> info-title;
    in property <[TableRow]> info-rows;
    in property <string> info-note;
    in property <string> info-action;
    callback info-run;
    in property <[string]> palette-items;
    in-out property <int> palette-index;
    callback palette-query(string);
    callback palette-run(int);
    callback shortcut(string);

    forward-focus: keys;
    // Every key a focused control does not use bubbles up to here.
    keys := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && event.text >= "1" && event.text <= "7" {
                root.previous-page = root.page;
                root.page = event.text.to-float() - 1;
                return accept;
            }
            if event.modifiers.control && (event.text == "k" || event.text == "K") { root.shortcut("palette"); return accept; }
            if event.text == Key.F1 || (event.text == "?" && root.dialog == 0) { root.shortcut("help"); return accept; }
            if event.text == Key.Escape && root.dialog != 0 { root.dialog = 0; return accept; }
            if event.text == Key.Escape && Pages.correcting { Pages.correcting = false; return accept; }
            reject
        }

    Rectangle { background: Tokens.background; }

    VerticalLayout {
        // ---- Title bar: no app name or icon; optional page title and a live status chip
        Rectangle {
            height: 32px;
            HorizontalLayout {
                padding-left: Tokens.l;
                spacing: Tokens.s;
                if show-page-title: Text {
                    text: pages[page].title;
                    color: window-active ? Tokens.on-surface-variant : Tokens.on-surface-variant.with-alpha(0.6);
                    font-size: Tokens.label;
                    vertical-alignment: center;
                }
                if live-chip != "": Rectangle {
                    y: 5px;
                    height: 22px;
                    width: chip-text.preferred-width + 30px;
                    border-radius: Tokens.pill(22px);
                    background: live-chip-tone == 1 ? Tokens.error-container : live-chip-tone == 2 ? Tokens.tertiary-container : Tokens.secondary-container;
                    HorizontalLayout {
                        padding-left: Tokens.s;
                        padding-right: Tokens.s;
                        spacing: Tokens.xs;
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - 8px) / 2;
                            border-radius: Tokens.pill(8px);
                            background: live-chip-tone == 1 ? Tokens.error : live-chip-tone == 2 ? Tokens.tertiary : Tokens.primary;
                        }
                        chip-text := Text {
                            text: live-chip;
                            font-size: Tokens.label;
                            color: live-chip-tone == 1 ? Tokens.on-error-container : live-chip-tone == 2 ? Tokens.on-tertiary-container : Tokens.on-secondary-container;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                CaptionButton { glyph: "\u{E921}"; label: "Minimize"; active: window-active; clicked => { root.minimize(); } }
                CaptionButton {
                    glyph: is-maximized ? "\u{E923}" : "\u{E922}";
                    label: is-maximized ? "Restore" : "Maximize";
                    active: window-active;
                    hover-override: max-hover;
                    clicked => { root.maximize(); }
                }
                CaptionButton { glyph: "\u{E8BB}"; label: "Close"; close: true; active: window-active; clicked => { root.request-close(); } }
            }
        }
        HorizontalLayout {
            // ---- Navigation rail: no branding; Settings pinned at the bottom
            VerticalLayout {
                width: 88px;
                padding-top: Tokens.xs;
                padding-bottom: Tokens.l;
                spacing: Tokens.m;
                for p[i] in pages: RailItem {
                    visible: i < 6;
                    height: i < 6 ? self.preferred-height : 0px;
                    icon: p.icon;
                    text: p.title;
                    selected: page == i;
                    clicked => { root.previous-page = root.page; root.page = i; }
                }
                Rectangle { vertical-stretch: 1; }
                RailItem {
                    icon: pages[6].icon;
                    text: pages[6].title;
                    selected: page == 6;
                    clicked => { root.previous-page = root.page; root.page = 6; }
                }
            }
            // ---- Page content
            Rectangle {
                horizontal-stretch: 1;
                if page == 0 || page == 3 || page == 4 || page == 5 || page == 6: ScrollView {
                    content-width: self.visible-width;
                    content-height: host.height;
                    host := PageHost {
                        forward: page > previous-page;
                        y: 0;
                        width: parent.width;
                        height: content.preferred-height;
                        content := VerticalLayout {
                            padding-left: Tokens.xl;
                            padding-right: Tokens.xl;
                            padding-top: Tokens.xs;
                            padding-bottom: Tokens.xl;
                            spacing: Tokens.m;
                            PageHeader {
                                title: pages[page].title;
                                subtitle: page == 0 ? overview-subtitle : page == 3 ? stats-subtitle : pages[page].sub;
                                if page == 0 && editing: Select {
                                    y: (parent.height - self.height) / 2;
                                    options: missing-widgets;
                                    current: 0;
                                    label: "Add widget";
                                    changed(i) => { root.add-widget(i); }
                                }
                                if page == 0 && editing: Button {
                                    y: (parent.height - self.height) / 2;
                                    text: "Reset layout";
                                    kind: "text";
                                    clicked => { root.reset-layout(); }
                                }
                                if page == 0: IconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.tune;
                                    tip: "Customize the dashboard";
                                    checked: editing;
                                    clicked => { root.editing = !root.editing; Dash.editing = root.editing; }
                                }
                                if page == 0: IconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.refresh;
                                    tip: "Check for new replays now";
                                    clicked => { root.overview-action("scan"); }
                                }
                                if page == 0: share := IconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.ios-share;
                                    tip: "Share a summary image (saved or copied, never uploaded)";
                                    clicked => { share-menu.show(); }
                                }
                                if page == 0: IconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.picture-in-picture-alt;
                                    tip: "Pop-out counter";
                                    clicked => { root.overview-action("overlay"); }
                                }
                            }
                            if page == 0: Text {
                                text: "●  " + status;
                                font-size: Tokens.body;
                                color: status-tone == 3 ? Tokens.error : status-tone == 2 ? Tokens.primary : Tokens.on-surface-variant;
                                wrap: word-wrap;
                            }
                            if page == 0: DashGrid {
                                rows: overview-rows;
                                editable: true;
                                columns-changed(n) => { root.columns-changed(n); }
                            }
                            if page == 3: DashGrid {
                                rows: stats-rows;
                                editable: false;
                                columns-changed(n) => { root.stats-columns-changed(n); }
                            }
                            if page == 4: TeammatesPage { }
                            if page == 5: TeamSessionsPage { }
                            if page == 6: SettingsPage { }
                        }
                    }
                }
                if page == 1 || page == 2: PageHost {
                    forward: page > previous-page;
                    VerticalLayout {
                        padding-left: Tokens.xl;
                        padding-right: Tokens.xl;
                        padding-top: Tokens.xs;
                        padding-bottom: Tokens.l;
                        spacing: Tokens.m;
                        PageHeader {
                            title: pages[page].title;
                            subtitle: pages[page].sub;
                            if page == 2: IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.undo;
                                tip: "Undo the last counted opening";
                                clicked => { Pages.action("undo"); }
                            }
                            if page == 2: IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.download;
                                tip: "Export the openings shown";
                                clicked => { Pages.action("export"); }
                            }
                            if page == 2: Rectangle {
                                width: 56px;
                                height: 56px;
                                border-radius: Tokens.r-lg;
                                background: fab.has-hover ? Tokens.primary-container.mix(Tokens.on-primary-container, 0.92) : Tokens.primary-container;
                                accessible-role: button;
                                accessible-label: "Add a manual chest";
                                accessible-action-default => { Pages.action("add"); }
                                Icon { name: Icons.add; size: 28px; color: Tokens.on-primary-container; }
                                fab := TouchArea { mouse-cursor: pointer; clicked => { Pages.action("add"); } }
                            }
                        }
                        if page == 1: MatchesPage { vertical-stretch: 1; }
                        if page == 2: OpeningsPage { vertical-stretch: 1; }
                    }
                }
            }
        }
    }

    }

    if Pages.correcting: CorrectDialog { }

    if dialog != 0: Rectangle {
        background: Tokens.shadow;
        TouchArea { clicked => { root.dialog = 0; } }
        Rectangle {
            width: min(root.width - 64px, 600px);
            height: min(root.height - 96px, box.preferred-height);
            border-radius: Tokens.r-xl;
            background: Tokens.container-high;
            clip: true;
            TouchArea { }
            box := VerticalLayout {
                padding: Tokens.xl;
                spacing: Tokens.m;
                alignment: start;
                if dialog == 1: TextField {
                    placeholder: "Type a page, match, teammate or setting";
                    label: "Command search";
                    leading-icon: Icons.search;
                    init => { self.focus(); }
                    edited(text) => { root.palette-query(text); }
                    accepted(text) => { root.palette-run(root.palette-index); }
                }
                if dialog == 1: palette := FocusScope {
                    height: min(360px, root.palette-items.length * Tokens.button-height);
                    key-pressed(event) => {
                        if event.text == Key.DownArrow { root.palette-index = min(root.palette-items.length - 1, root.palette-index + 1); return accept; }
                        if event.text == Key.UpArrow { root.palette-index = max(0, root.palette-index - 1); return accept; }
                        if event.text == "\n" { root.palette-run(root.palette-index); return accept; }
                        reject
                    }
                    ListView {
                        for item[i] in root.palette-items: Rectangle {
                            height: Tokens.button-height;
                            border-radius: Tokens.r-sm;
                            background: i == root.palette-index ? Tokens.secondary-container : hover.has-hover ? Tokens.on-surface.with-alpha(0.08) : transparent;
                            accessible-role: list-item;
                            accessible-label: item;
                            accessible-item-selected: i == root.palette-index;
                            Text {
                                x: Tokens.m;
                                width: parent.width - 2 * Tokens.m;
                                text: item;
                                color: i == root.palette-index ? Tokens.on-secondary-container : Tokens.on-surface;
                                font-size: Tokens.body;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            hover := TouchArea { mouse-cursor: pointer; clicked => { root.palette-run(i); } }
                        }
                    }
                }
                if dialog == 2: Text { text: root.info-title; font-size: Tokens.headline; color: Tokens.on-surface; wrap: word-wrap; }
                if dialog == 2: VerticalLayout {
                    spacing: Tokens.s;
                    for row in root.info-rows: HorizontalLayout {
                        spacing: Tokens.l;
                        for cell[i] in row.cells: Text {
                            text: cell.text;
                            // The last cell takes the remaining width, so long lines wrap inside the dialog.
                            min-width: 0px;
                            preferred-width: row.cells.length > 1 ? (i == 0 ? 170px : 330px) : 530px; // close to the real width, so the height estimate fits
                            horizontal-stretch: i == row.cells.length - 1 ? 1 : 0;
                            font-size: Tokens.body;
                            font-weight: cell.tone == 1 ? 600 : 400;
                            color: cell.tone == 0 ? Tokens.on-surface-variant : cell.tone == 3 ? Tokens.error : Tokens.on-surface;
                            wrap: word-wrap;
                        }
                    }
                }
                if dialog == 2 && root.info-note != "": Text { text: root.info-note; font-size: Tokens.body; color: Tokens.on-surface-variant; wrap: word-wrap; }
                if dialog == 2: HorizontalLayout {
                    alignment: end;
                    spacing: Tokens.s;
                    if root.info-action != "": Button { text: "Later"; kind: "text"; clicked => { root.dialog = 0; } }
                    if root.info-action != "": Button { text: root.info-action; kind: "filled"; clicked => { root.dialog = 0; root.info-run(); } }
                    if root.info-action == "": Button { text: "OK"; kind: "filled"; clicked => { root.dialog = 0; } }
                }
            }
        }
    }

    share-menu := PopupWindow {
        x: root.width - 300px;
        y: 96px;
        width: 240px;
        Rectangle {
            background: Tokens.container-high;
            border-radius: Tokens.r-md;
            drop-shadow-blur: 12px;
            drop-shadow-color: Tokens.shadow;
            VerticalLayout {
                padding: Tokens.xs;
                for item in ["Copy summary image", "Save summary image…", "Copy weekly recap", "Save weekly recap…"]: Rectangle {
                    height: Tokens.button-height;
                    border-radius: Tokens.r-sm;
                    background: ta.has-hover ? Tokens.on-surface.with-alpha(0.08) : transparent;
                    Text { x: Tokens.m; height: parent.height; text: item; color: Tokens.on-surface; font-size: Tokens.body; vertical-alignment: center; }
                    ta := TouchArea { mouse-cursor: pointer; clicked => { root.overview-action(item); } }
                }
            }
        }
    }

    // ---- Tooltip
    if Tip.text != "": Rectangle {
        property <length> w: min(320px, tip-text.preferred-width + 2 * Tokens.s);
        x: clamp(Tip.x - self.w / 2, 4px, root.width - self.w - 4px);
        y: Tip.above ? max(4px, Tip.y - self.height - 6px) : min(root.height - self.height - 4px, Tip.y + 6px);
        width: w;
        height: tip-text.preferred-height + 2 * Tokens.xs;
        border-radius: Tokens.r-xs;
        background: Tokens.inverse-surface;
        tip-text := Text {
            x: Tokens.s;
            width: parent.width - 2 * Tokens.s;
            text: Tip.text;
            color: Tokens.inverse-on-surface;
            font-size: Tokens.label;
            wrap: word-wrap;
        }
    }

    // ---- Snackbar
    snackbar := Rectangle {
        property <bool> up: snack != "";
        x: (root.width - self.width) / 2;
        y: up ? root.height - self.height - Tokens.xl : root.height + 8px;
        width: min(560px, snack-text.preferred-width + 2 * Tokens.l);
        height: snack-text.preferred-height + 2 * Tokens.m;
        border-radius: Tokens.r-xs;
        background: Tokens.inverse-surface;
        animate y { duration: Tokens.medium; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
        snack-text := Text {
            x: Tokens.l;
            width: parent.width - 2 * Tokens.l;
            text: snack;
            color: Tokens.inverse-on-surface;
            font-size: Tokens.body;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        accessible-role: text;
        accessible-label: snack;
    }
}
