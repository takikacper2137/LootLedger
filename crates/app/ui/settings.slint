// Settings: every option from LootLedger 0.7.1. Values come from Rust; changes go back through Settings.set.
import { Tokens } from "tokens.slint";
import { Icons } from "icons.slint";
import { Icon, IconButton, Button, Chip, Switch, Segmented, TextField, Slider, Stepper, Card } from "controls.slint";

export global Settings {
    in property <int> theme;          // light, dark, system
    in property <string> seed;
    in property <[color]> seeds;
    in property <[string]> seed-names;
    in property <int> seed-index: -1;
    in property <bool> contrast;
    in property <int> corners;        // sharp, default, round
    in property <int> density;        // compact, comfortable
    in property <int> font-scale;     // S M L XL
    in property <bool> colorblind;
    in property <int> chart-style;    // bar line smooth area
    in property <int> background;     // solid tonal
    in property <int> motion;         // full reduced off
    in property <bool> show-page-title;
    in property <[string]> tile-names;
    in property <[bool]> tiles-on;
    in property <bool> time-24h;
    in property <int> date-format;
    in property <int> separators;
    in property <int> playtime;
    in property <int> default-range;
    in property <string> folder;
    in property <bool> auto-watch;
    in property <bool> share-host;
    in property <string> share-password;
    in property <string> share-peer;
    in property <string> share-join-password;
    in property <string> share-status;
    in property <int> scan-seconds: 30;
    in property <bool> count-broken;
    in property <bool> live-tracking;
    in property <int> live-seconds;   // index of 1, 2, 5, 10 s
    in property <bool> overlay;
    in property <int> overlay-opacity;
    in property <int> overlay-size;
    in property <int> overlay-corner;
    in property <bool> overlay-click-through;
    in property <bool> overlay-teammates;
    in property <bool> sound;
    in property <bool> match-popup;
    in property <int> volume;
    in property <int> goal-daily;
    in property <int> goal-weekly;
    in property <bool> celebrate;
    in property <string> hotkey-add;
    in property <string> hotkey-undo;
    in property <string> hotkey-overlay;
    in property <string> data-folder;
    in property <string> version;
    in property <bool> auto-update;
    callback set(string, string);
    callback action(string);
}

component Row inherits HorizontalLayout {
    in property <string> name;
    in property <string> hint;
    spacing: Tokens.l;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: Tokens.xxs;
        Text { text: name; font-size: Tokens.body; color: Tokens.on-surface; wrap: word-wrap; }
        if hint != "": Text { text: hint; font-size: Tokens.body; color: Tokens.on-surface-variant; wrap: word-wrap; }
    }
    HorizontalLayout {
        alignment: end;
        @children
    }
}

component Section inherits Card {
    VerticalLayout {
        spacing: Tokens.m;
        @children
    }
}

export component SettingsPage inherits VerticalLayout {
    spacing: Tokens.m;
    Section {
        title: "Appearance";
        icon: Icons.palette;
        Row {
            name: "Theme";
            Segmented { options: ["Light", "Dark", "System"]; current: Settings.theme; label: "Colour theme"; changed(i) => { Settings.set("theme", i); } }
        }
        Row {
            name: "Accent colour";
            hint: "Presets or your own #rrggbb. Everything is tuned from it.";
            HorizontalLayout {
                spacing: Tokens.s;
                for c[i] in Settings.seeds: Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - 28px) / 2;
                    border-radius: Tokens.pill(28px);
                    border-width: 3px;
                    border-color: i == Settings.seed-index ? Tokens.on-surface : Tokens.container-high;
                    background: c;
                    accessible-role: button;
                    accessible-label: Settings.seed-names[i] + " accent colour";
                    accessible-action-default => { Settings.set("seed-index", i); }
                    TouchArea { mouse-cursor: pointer; clicked => { Settings.set("seed-index", i); } }
                }
                TextField {
                    width: 120px;
                    text: Settings.seed;
                    placeholder: "#rrggbb";
                    label: "Custom accent colour";
                    accepted(text) => { Settings.set("seed", text); }
                }
            }
        }
        Row {
            name: "Higher contrast";
            hint: "Stronger outlines and muted text.";
            Switch { checked: Settings.contrast; label: "Higher contrast"; toggled(on) => { Settings.set("contrast", on ? "true" : "false"); } }
        }
        Row {
            name: "Corners";
            Segmented { options: ["Sharp", "Default", "Round"]; current: Settings.corners; label: "Corner radius"; changed(i) => { Settings.set("corners", i); } }
        }
        Row {
            name: "Density";
            Segmented { options: ["Compact", "Comfortable"]; current: Settings.density; label: "Spacing"; changed(i) => { Settings.set("density", i); } }
        }
        Row {
            name: "Text size";
            Segmented { options: ["S", "M", "L", "XL"]; current: Settings.font-scale; label: "Text size"; changed(i) => { Settings.set("font_scale", i); } }
        }
        Row {
            name: "Colourblind-safe chest colours";
            hint: "Chest types keep one colour everywhere. This swaps in a palette that stays apart for most colour vision.";
            Switch { checked: Settings.colorblind; label: "Colourblind-safe chest colours"; toggled(on) => { Settings.set("colorblind", on ? "true" : "false"); } }
        }
        Row {
            name: "Chart style";
            Segmented { options: ["Bar", "Line", "Smooth", "Area"]; current: Settings.chart-style; label: "Chart style"; changed(i) => { Settings.set("chart_style", i); } }
        }
        Row {
            name: "Background";
            hint: "A soft tonal wash instead of a flat colour.";
            Segmented { options: ["Solid", "Tonal"]; current: Settings.background; label: "Background"; changed(i) => { Settings.set("background", i); } }
        }
        Row {
            name: "Animations";
            hint: "Reduced keeps short fades only. Windows' 'Show animations' off means Reduced.";
            Segmented { options: ["Full", "Reduced", "Off"]; current: Settings.motion; label: "Animations"; changed(i) => { Settings.set("motion", i); } }
        }
        Row {
            name: "Show page title in title bar";
            hint: "Off by default: the page title is already at the top of each page.";
            Switch { checked: Settings.show-page-title; label: "Show page title in title bar"; toggled(on) => { Settings.set("show_page_title", on ? "true" : "false"); } }
        }
    }
    Section {
        title: "Overview tiles";
        icon: Icons.dashboard-customize;
        Row {
            name: "Summary tiles";
            hint: "Choose which stats appear on Overview. Use Customize there to move and resize them.";
            Rectangle {
                width: 3 * 150px + 2 * Tokens.s;
                height: ceil(Settings.tile-names.length / 3) * (32px + Tokens.s);
                for name[i] in Settings.tile-names: Chip {
                    x: mod(i, 3) * (150px + Tokens.s);
                    y: floor(i / 3) * (32px + Tokens.s);
                    width: 150px;
                    text: name;
                    checked: Settings.tiles-on[i];
                    toggled(on) => { Settings.set("tile:" + i, on ? "true" : "false"); }
                }
            }
        }
    }
    Section {
        title: "Formats";
        icon: Icons.schedule;
        Row {
            name: "24-hour clock";
            Switch { checked: Settings.time-24h; label: "24-hour clock"; toggled(on) => { Settings.set("time_24h", on ? "true" : "false"); } }
        }
        Row {
            name: "Date format";
            Segmented { options: ["dd/mm/yyyy", "mm/dd/yyyy", "yyyy-mm-dd"]; current: Settings.date-format; label: "Date format"; changed(i) => { Settings.set("date_format", i); } }
        }
        Row {
            name: "Number separator";
            Segmented { options: ["1,234", "1.234", "1 234", "1234"]; current: Settings.separators; label: "Thousands separator"; changed(i) => { Settings.set("separators", i); } }
        }
        Row {
            name: "Playtime shown as";
            Segmented { options: ["12h 40m", "12.7 h"]; current: Settings.playtime; label: "Playtime"; changed(i) => { Settings.set("playtime", i); } }
        }
        Row {
            name: "Default date range";
            hint: "Used for the trend chart and the Matches filter.";
            Segmented { options: ["7 days", "30 days", "90 days", "All time"]; current: Settings.default-range; label: "Default date range"; changed(i) => { Settings.set("default_range", i); } }
        }
    }
    Section {
        title: "Replays";
        icon: Icons.folder-open;
        Row {
            name: "Replay folder";
            hint: "Fortnite's default is Saved\\Demos under FortniteGame.";
            HorizontalLayout {
                spacing: Tokens.s;
                TextField { width: 300px; text: Settings.folder; label: "Replay folder"; accepted(text) => { Settings.set("replay_folder", text); } }
                IconButton { icon: Icons.folder; tip: "Choose the replay folder"; clicked => { Settings.action("browse-folder"); } }
                IconButton { icon: Icons.open-in-new; tip: "Open the replay folder"; clicked => { Settings.action("open-replays"); } }
            }
        }
        Row {
            name: "Watch for new replays";
            hint: "Finished matches are added on their own.";
            Switch { checked: Settings.auto-watch; label: "Check for replays automatically"; toggled(on) => { Settings.set("auto_watch", on ? "true" : "false"); } }
        }
        Row {
            name: "Check every";
            Stepper { value: Settings.scan-seconds; minimum: 5; maximum: 600; step: 5; suffix: " s"; label: "Replay check interval"; changed(v) => { Settings.set("scan_seconds", v); } }
        }
        Row {
            name: "Count broken-open chests";
            hint: "Chests destroyed by your damage before anyone searched them. Their loot still spills.";
            Switch { checked: Settings.count-broken; label: "Count chests you broke open"; toggled(on) => { Settings.set("count_broken", on ? "true" : "false"); } }
        }
        Row {
            name: "Read every replay again";
            hint: "Re-reads all replays Fortnite still keeps. Your corrections are kept.";
            Button { text: "Read all replays again"; clicked => { Settings.action("rescan"); } }
        }
    }
    Section {
        title: "Live match and counter";
        icon: Icons.sensors;
        Text {
            text: "LootLedger only reads files Fortnite writes on this PC: the replay and the game's log time. It never touches the Fortnite process: no injection, hooks, memory reading or drawing over the game. The counter is an ordinary LootLedger window that stays on top.";
            font-size: Tokens.body;
            color: Tokens.on-surface-variant;
            wrap: word-wrap;
        }
        Row {
            name: "Track the current match";
            hint: "Fortnite encrypts the replay until the match ends, so the chest count arrives then, seconds after the match. During the match you see that it is live and how long it has run.";
            Switch { checked: Settings.live-tracking; label: "Track the current match"; toggled(on) => { Settings.set("live_tracking", on ? "true" : "false"); } }
        }
        Row {
            name: "Check every";
            hint: "Fortnite saves the replay about every 20 s. Each check reads one file header.";
            Segmented { options: ["1 s", "2 s", "5 s", "10 s"]; current: Settings.live-seconds; label: "Live check interval"; changed(i) => { Settings.set("live_seconds", i); } }
        }
        Row {
            name: "Pop-out counter";
            hint: "A small always-on-top window with the count. Drag and resize it; it remembers where it was.";
            Switch { checked: Settings.overlay; label: "Pop-out counter"; toggled(on) => { Settings.set("overlay", on ? "true" : "false"); } }
        }
        Row {
            name: "Counter opacity";
            Slider { value: Settings.overlay-opacity; minimum: 30; maximum: 100; label: "Counter opacity"; changed(v) => { Settings.set("overlay_opacity", v); } }
        }
        Row {
            name: "Counter size";
            Segmented { options: ["S", "M", "L"]; current: Settings.overlay-size; label: "Counter size"; changed(i) => { Settings.set("overlay_size", i); } }
        }
        Row {
            name: "Counter position";
            Segmented {
                options: ["Where I put it", "Top left", "Top right", "Bottom left", "Bottom right"];
                current: Settings.overlay-corner;
                label: "Counter position";
                changed(i) => { Settings.set("overlay_corner", i); }
            }
        }
        Row {
            name: "Click through the counter";
            hint: "Clicks pass to the window underneath. Turn this off here to move the counter again.";
            Switch { checked: Settings.overlay-click-through; label: "Click through the counter"; toggled(on) => { Settings.set("overlay_click_through", on ? "true" : "false"); } }
        }
        Row {
            name: "Teammates in the counter";
            Switch { checked: Settings.overlay-teammates; label: "Teammates in the counter"; toggled(on) => { Settings.set("overlay_teammates", on ? "true" : "false"); } }
        }
        Row {
            name: "Pop-up after each match";
            hint: "Your chests, placement and how it compares, in the corner for a few seconds. It never takes focus from the game.";
            Switch { checked: Settings.match-popup; label: "Pop-up after each match"; toggled(on) => { Settings.set("match_popup", on ? "true" : "false"); } }
        }
        Row {
            name: "Sound when a match is counted";
            Switch { checked: Settings.sound; label: "Sound when a match is counted"; toggled(on) => { Settings.set("sound", on ? "true" : "false"); } }
        }
        Row {
            name: "Volume";
            Slider { value: Settings.volume; minimum: 0; maximum: 100; label: "Sound volume"; changed(v) => { Settings.set("volume", v); } }
        }
    }
    Section {
        title: "Goals";
        icon: Icons.flag;
        Row {
            name: "Daily goal";
            hint: "Chests per day. Type a number or pick a preset.";
            Stepper {
                width: 220px;
                value: Settings.goal-daily;
                maximum: 10000;
                step: 5;
                special: "No goal";
                label: "Daily goal";
                preset-names: ["No goal", "10", "25", "50", "100", "Custom…"];
                preset-values: [0, 10, 25, 50, 100, -1];
                changed(v) => { Settings.set("goal_daily", v); }
            }
        }
        Row {
            name: "Weekly goal";
            hint: "Chests per week, Monday to Sunday.";
            Stepper {
                width: 220px;
                value: Settings.goal-weekly;
                maximum: 100000;
                step: 5;
                special: "No goal";
                label: "Weekly goal";
                preset-names: ["No goal", "50", "100", "250", "500", "Custom…"];
                preset-values: [0, 50, 100, 250, 500, -1];
                changed(v) => { Settings.set("goal_weekly", v); }
            }
        }
        Row {
            name: "Celebrate goals and trophies";
            hint: "A short message inside LootLedger. Nothing is sent anywhere.";
            Switch { checked: Settings.celebrate; label: "Celebrate goals and trophies"; toggled(on) => { Settings.set("celebrate", on ? "true" : "false"); } }
        }
    }
    Section {
        title: "Shortcuts";
        icon: Icons.keyboard;
        Row {
            name: "Add one chest";
            hint: "Works in any app. Example: Ctrl+Alt+F8";
            TextField { width: 200px; text: Settings.hotkey-add; label: "Manual +1 shortcut"; accepted(text) => { Settings.set("hotkey_add", text); } }
        }
        Row {
            name: "Undo last chest";
            hint: "Example: Ctrl+Alt+F9";
            TextField { width: 200px; text: Settings.hotkey-undo; label: "Undo shortcut"; accepted(text) => { Settings.set("hotkey_undo", text); } }
        }
        Row {
            name: "Show or hide the counter";
            hint: "Example: Ctrl+Alt+F10. Leave empty to turn a shortcut off. Press ? in LootLedger for all shortcuts.";
            TextField { width: 200px; text: Settings.hotkey-overlay; label: "Show or hide the counter shortcut"; accepted(text) => { Settings.set("hotkey_overlay", text); } }
        }
    }
    Section {
        title: "Data";
        icon: Icons.database;
        Row {
            name: "Ledger and settings";
            hint: "Stored in " + Settings.data-folder + ". Backups hold matches, openings and your edit history.";
            VerticalLayout {
                spacing: Tokens.s;
                for pair in [["Export ledger", "Create backup"], ["Restore backup", "Open data folder"], ["Export settings", "Import settings"]]: HorizontalLayout {
                    spacing: Tokens.s;
                    for text in pair: Button { min-width: 180px; text: text; clicked => { Settings.action(text); } }
                }
                HorizontalLayout {
                    spacing: Tokens.s;
                    Button { min-width: 180px; text: "Check for updates"; clicked => { Settings.action("Check for updates"); } }
                    Button { min-width: 180px; text: "Clear all data…"; kind: "danger"; clicked => { Settings.action("Clear all data"); } }
                }
            }
        }
        Text {
            text: "Clearing saves a backup first. Replay files stay on your PC and are not read again until you choose Read all replays again.";
            font-size: Tokens.body;
            color: Tokens.on-surface-variant;
            wrap: word-wrap;
        }
    }
    Section {
        title: "About";
        icon: Icons.info;
        Text {
            text: "LootLedger " + Settings.version + " · counts the chests you open in Fortnite from the replays on this PC. Your data stays on this PC unless you turn on match sharing.";
            font-size: Tokens.body;
            color: Tokens.on-surface;
            wrap: word-wrap;
        }
        Row {
            name: "Update automatically";
            hint: "Asks GitHub for a newer LootLedger and installs it when you close the app. Only the version check and the download go over the internet; none of your data is sent.";
            Switch { checked: Settings.auto-update; label: "Update automatically"; toggled(on) => { Settings.set("auto_update", on ? "true" : "false"); } }
        }
        HorizontalLayout {
            alignment: start;
            Button { text: "What's new"; kind: "text"; clicked => { Settings.action("What's new"); } }
        }
    }
}

/// The Party page: combine your recordings with friends you played with, by file or over Tailscale.
export component SharingPage inherits VerticalLayout {
    spacing: Tokens.m;
    Section {
        title: "Play with friends";
        icon: Icons.groups;
        Text {
            text: "How it works: you and your friends each keep your own recordings. After a match you played together, the app combines them, so everyone's number comes from the best recording. Over the internet: install the free Tailscale app on both PCs, then one of you switches on \"Let friends connect to me\" and the other types in that PC's Tailscale address and the room password.";
            font-size: Tokens.body;
            color: Tokens.on-surface;
            wrap: word-wrap;
        }
        Row {
            name: "Match with a friend's replay";
            hint: "Played together? Add your friend's replay of the same match. Everyone's chests are then taken from the best recording, so a friend whose PC recorded little still gets the right number. Their chests never count towards your own totals.";
            Button { min-width: 180px; text: "Add partner replay…"; clicked => { Settings.action("Add partner replay"); } }
        }
        Row {
            name: "Let friends connect to me";
            hint: "Play together over the internet without sending files. Needs the free Tailscale app on both PCs. Only the match summary (names and chest counts) is shared, only for matches you played together, and only with someone who knows your room password.";
            Switch { checked: Settings.share-host; label: "Let friends connect to me"; toggled(on) => { Settings.set("share_host", on ? "true" : "false"); } }
        }
        if Settings.share-host: Row {
            name: "Your room password";
            hint: "Give this to your friends. Press Enter after changing it.";
            TextField { width: 200px; text: Settings.share-password; label: "Room password"; accepted(text) => { Settings.set("share_password", text); } }
        }
        Row {
            name: "Connect to a friend";
            hint: "Their Tailscale address (for example 100.64.1.2) and the room password they gave you. Leave the address empty to stay disconnected.";
            VerticalLayout {
                spacing: Tokens.s;
                TextField { width: 220px; text: Settings.share-peer; placeholder: "Friend's address"; label: "Friend's address"; accepted(text) => { Settings.set("share_peer", text); } }
                TextField { width: 220px; text: Settings.share-join-password; placeholder: "Their room password"; label: "Their room password"; accepted(text) => { Settings.set("share_join_password", text); } }
                Button { min-width: 180px; text: "Share matches now"; clicked => { Settings.action("Share matches now"); } }
            }
        }
        if Settings.share-status != "": Text {
            text: Settings.share-status;
            font-size: Tokens.body;
            color: Tokens.on-surface-variant;
            wrap: word-wrap;
        }
    }
}
