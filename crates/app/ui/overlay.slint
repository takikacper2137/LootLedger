// The pop-out counter: an ordinary always-on-top LootLedger window. It never attaches to or draws over the
// game. Colours come from the main window's tokens through these properties.

export component Overlay inherits Window {
    title: "LootLedger counter";
    default-font-family: "Segoe UI";
    no-frame: true;
    always-on-top: true;
    in property <float> scale: 1;
    in property <string> heading;
    in property <string> count;
    in property <string> lines;
    // Flipped on every update: it changes the card's own colour a hair, so the whole card is repainted. Without
    // it only the first line was seen to repaint on some PCs and the counter looked stuck.
    in property <bool> flip;
    in property <color> surface;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <length> radius;
    in property <length> pad;
    callback drag();
    width: 240px * scale;
    height: content.preferred-height;
    background: transparent;
    Rectangle {
        border-radius: radius;
        background: flip ? surface.with-alpha(0.99) : surface;
        content := VerticalLayout {
            padding: pad;
            spacing: pad / 4;
            Text { text: heading; font-size: 13px * scale; color: muted; }
            Text { text: count; font-size: 40px * scale; font-weight: 700; color: accent; }
            if lines != "": Text { text: lines; font-size: 12px * scale; color: ink; wrap: word-wrap; }
        }
        TouchArea {
            mouse-cursor: move;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { drag(); }
            }
        }
    }
}

// Shown for a few seconds after a match is counted. Never takes focus; a click closes it.
export component MatchPopup inherits Window {
    title: "LootLedger";
    default-font-family: "Segoe UI";
    no-frame: true;
    always-on-top: true;
    in property <string> heading;
    in property <string> count;
    in property <string> detail;
    in property <color> surface;
    in property <color> outline;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <length> radius;
    in property <length> pad;
    callback dismiss();
    width: 300px;
    height: content.preferred-height;
    background: transparent;
    Rectangle {
        border-radius: radius;
        border-width: 1px;
        border-color: outline;
        background: surface;
        content := VerticalLayout {
            padding: pad;
            spacing: pad / 4;
            Text { text: heading; font-size: 13px; color: muted; overflow: elide; }
            HorizontalLayout {
                alignment: start;
                spacing: pad / 2;
                Text { text: count; font-size: 40px; font-weight: 700; color: accent; }
                Text { text: count == "1" ? "chest" : "chests"; font-size: 16px; color: ink; vertical-alignment: bottom; }
            }
            if detail != "": Text { text: detail; font-size: 12px; color: ink; wrap: word-wrap; }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { dismiss(); }
        }
    }
}
